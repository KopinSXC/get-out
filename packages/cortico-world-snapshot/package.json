{
  "name": "cortico-world-snapshot",
  "version": "0.1.2",
  "description": "给工作区做时间点快照:创建、列出、回滚、删除。",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "cortico-world",
    "snapshot",
    "backup"
  ],
  "files": [
    "src",
    "dist",
    "describe.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "scripts",
    "test",
    "tsconfig.json",
    "eslint.config.js"
  ],
  "cortico": {
    "kind": "world",
    "api": 6,
    "displayName": "工作区快照",
    "tags": [
      "utility",
      "backup"
    ],
    "describe": "describe.json",
    "webUiClient": "./dist/webui.js",
    "webUiStyle": "./dist/webui.css"
  },
  "scripts": {
    "build": "esbuild src/webui.ts --bundle --format=esm --platform=browser --target=es2022 --outfile=dist/webui.js && node -e \"require('node:fs').copyFileSync('src/webui.css','dist/webui.css')\" && tsx scripts/check-extension.ts --write",
    "typecheck": "tsc --noEmit -p .",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run build && npm run typecheck && npm run lint && npm test && tsx scripts/check-extension.ts",
    "verify": "tsc --noEmit -p . && eslint . && vitest run && tsx scripts/check-extension.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "cortico": "^0.2.12",
    "esbuild": "^0.24.0",
    "eslint": "^9.17.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^3.0.0"
  }
}
